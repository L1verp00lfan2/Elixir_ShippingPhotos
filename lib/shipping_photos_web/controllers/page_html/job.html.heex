<h1>📦 Job Details</h1>

<p>
  Job Number: <%= @id %>
</p>

<h2>Photos Found</h2>

<div style="display: flex; flex-wrap: wrap; gap: 20px;">

  <%= for photo <- @photos do %>
    <div style="width: 220px; text-align: center;">

      <.link navigate={~p"/job/#{@id}/photo/#{photo}"}>
        <img
          src={"/image/#{photo}"}
          style="max-width: 200px; max-height: 200px; border: 1px solid #ccc;"
        />
      </.link>

      <p style="font-size: 12px; word-break: break-word;">
        <%= photo %>
      </p>

    </div>
  <% end %>

</div>
